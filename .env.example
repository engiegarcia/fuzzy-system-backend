# Copie este archivo a .env y ajuste los valores (cp .env.example .env).

# Orígenes permitidos por CORS: lista JSON o valores separados por comas.
# En producción indique solo el dominio del frontend (nunca "*").
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
# true → una línea JSON por registro (recomendado en producción)
LOG_JSON=false

# dev | prod
ENVIRONMENT=dev

# Resolución del universo de salida para el centroide (0 < paso <= 1).
# 0.01 reproduce los casos verificados del informe; un paso mayor es más rápido y menos preciso.
PASO_SALIDA=0.01

# Límites de /api/evaluar/lote y /api/barrido
MAX_LOTE=1000
MAX_PASOS_BARRIDO=500

# Puerto publicado por docker-compose
BACKEND_PORT=8000
